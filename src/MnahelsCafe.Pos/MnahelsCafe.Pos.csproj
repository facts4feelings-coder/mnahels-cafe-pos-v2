<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Mnahel's Cafe POS · Proprietary software · Eastern Cross Technology -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>0.15.41</Version>
    <ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">Assets\MnahelsCafe.ico</ApplicationIcon>
    <Company>Eastern Cross Technology</Company>
    <Authors>Eastern Cross Technology (techmint.org)</Authors>
    <Product>Mnahel's Cafe POS · a product by Eastern Cross Technology</Product>
    <AssemblyTitle>Mnahel's Cafe POS · a product by Eastern Cross Technology</AssemblyTitle>
    <Description>Proprietary point of sale software owned by Eastern Cross Technology (techmint.org). Licensed per device.</Description>
    <Copyright>Copyright © 2026 Eastern Cross Technology · techmint.org · All rights reserved.</Copyright>
    <Trademark>Eastern Cross Technology</Trademark>
    <PackageProjectUrl>https://techmint.org</PackageProjectUrl>
    <RepositoryUrl>https://techmint.org</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="LEGAL-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="AGENTS.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include=".cursorrules" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="GenerateMnahelsIcon" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT' and Exists('$(ProjectDir)Assets\MnahelsCafe.ico.b64')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$bytes=[Convert]::FromBase64String([IO.File]::ReadAllText('$(ProjectDir)Assets\MnahelsCafe.ico.b64'));[IO.File]::WriteAllBytes('$(ProjectDir)Assets\MnahelsCafe.ico',$bytes);[IO.File]::WriteAllBytes('$(ProjectDir)wwwroot\favicon.ico',$bytes)&quot;" />
  </Target>
  <Target Name="GenerateV41VisualAssets" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(ProjectDir)wwwroot\assets\menu" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$brand=[IO.File]::ReadAllText('$(ProjectDir)wwwroot\assets\brand\mnahels-logo-v41.part1.b64')+[IO.File]::ReadAllText('$(ProjectDir)wwwroot\assets\brand\mnahels-logo-v41.part2.b64');[IO.File]::WriteAllText('$(ProjectDir)wwwroot\assets\brand\mnahels-logo.b64',$brand);$names=@('coffee','cardamom-tea','karrak-tea','black-coffee','green-tea');foreach($name in $names){$src='$(ProjectDir)wwwroot\assets\menu-source\'+$name+'.webp.b64';$dst='$(ProjectDir)wwwroot\assets\menu\'+$name+'.webp';[IO.File]::WriteAllBytes($dst,[Convert]::FromBase64String([IO.File]::ReadAllText($src)))}&quot;" />
  </Target>
</Project>
