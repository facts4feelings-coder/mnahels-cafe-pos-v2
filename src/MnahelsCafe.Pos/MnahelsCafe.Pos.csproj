  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>0.15.37</Version>
    <ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">Assets\MnahelsCafe.ico</ApplicationIcon>
    <Company>Eastern Cross Technology</Company>
    <Authors>Eastern Cross Technology (techmint.org)</Authors>
    <Product>Mnahel's Cafe POS · a product by Eastern Cross Technology</Product>
    <AssemblyTitle>Mnahel's Cafe POS · a product by Eastern Cross Technology</AssemblyTitle>
