    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="LEGAL-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="AGENTS.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include=".cursorrules" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="GenerateMnahelsIcon" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT' and Exists('$(ProjectDir)Assets\MnahelsCafe.ico.b64')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$bytes=[Convert]::FromBase64String([IO.File]::ReadAllText('$(ProjectDir)Assets\MnahelsCafe.ico.b64'));[IO.File]::WriteAllBytes('$(ProjectDir)Assets\MnahelsCafe.ico',$bytes);[IO.File]::WriteAllBytes('$(ProjectDir)wwwroot\favicon.ico',$bytes)&quot;" />
  </Target>
