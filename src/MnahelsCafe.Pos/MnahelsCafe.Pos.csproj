<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><InvariantGlobalization>false</InvariantGlobalization><Version>0.15.56</Version><ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">Assets\MnahelsCafe.ico</ApplicationIcon><Company>Eastern Cross Technology</Company><Authors>Eastern Cross Technology (techmint.org)</Authors><Product>Mnahel's Cafe POS · a product by Eastern Cross Technology</Product><AssemblyTitle>Mnahel's Cafe POS · a product by Eastern Cross Technology</AssemblyTitle><Description>Proprietary point of sale software owned by Eastern Cross Technology. Licensed per device.</Description><Copyright>Copyright © 2026 Eastern Cross Technology · All rights reserved.</Copyright><Trademark>Eastern Cross Technology</Trademark><PackageProjectUrl>https://techmint.org</PackageProjectUrl><RepositoryUrl>https://techmint.org</RepositoryUrl></PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" /><PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" /></ItemGroup>
  <ItemGroup><Content Include="LEGAL-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /><Content Include="AGENTS.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /><Content Include=".cursorrules" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <Target Name="GenerateMnahelsIcon" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT' and Exists('$(ProjectDir)Assets\MnahelsCafe.ico.b64')"><Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$bytes=[Convert]::FromBase64String([IO.File]::ReadAllText('$(ProjectDir)Assets\MnahelsCafe.ico.b64'));[IO.File]::WriteAllBytes('$(ProjectDir)Assets\MnahelsCafe.ico',$bytes);[IO.File]::WriteAllBytes('$(ProjectDir)wwwroot\favicon.ico',$bytes)&quot;" /></Target>
  <Target Name="GenerateV42VisualAssets" BeforeTargets="PrepareForBuild"><MakeDir Directories="$(ProjectDir)wwwroot\assets\menu" /><Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$parts=1..3|ForEach-Object{[IO.File]::ReadAllText(('$(ProjectDir)wwwroot\assets\brand\mnahels-logo-v42.part{0}.b64'-f $_))};[IO.File]::WriteAllText('$(ProjectDir)wwwroot\assets\brand\mnahels-logo.b64',($parts-join''));$names=@('coffee','cardamom-tea','karrak-tea','black-coffee','green-tea');foreach($name in $names){$src='$(ProjectDir)wwwroot\assets\menu-source\'+$name+'.webp.b64';$dst='$(ProjectDir)wwwroot\assets\menu\'+$name+'.webp';[IO.File]::WriteAllBytes($dst,[Convert]::FromBase64String([IO.File]::ReadAllText($src)))}&quot;" /><Exec Command="node &quot;$(MSBuildProjectDirectory)\..\..\scripts\apply-v42-runtime.cjs&quot;" /><Exec Command="node &quot;$(MSBuildProjectDirectory)\..\..\scripts\apply-v43-running-order.cjs&quot;" /><Exec Command="node &quot;$(MSBuildProjectDirectory)\..\..\scripts\apply-v44-hotfix.cjs&quot;" /><Exec Command="node &quot;$(MSBuildProjectDirectory)\..\..\scripts\apply-v47-order-console.cjs&quot;" /><Exec Command="node &quot;$(MSBuildProjectDirectory)\..\..\scripts\apply-v48-order-log-slips.cjs&quot;" /><Exec Command="node &quot;$(MSBuildProjectDirectory)\..\..\scripts\apply-v54-receipt-fix.cjs&quot;" /><Exec Command="node &quot;$(MSBuildProjectDirectory)\..\..\scripts\apply-v56-order-flow.cjs&quot;" /><Exec Command="node &quot;$(MSBuildProjectDirectory)\..\..\scripts\apply-web-performance.cjs&quot;" /></Target>
</Project>