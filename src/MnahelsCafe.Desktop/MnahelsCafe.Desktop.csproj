<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>MnahelsCafe.Desktop</AssemblyName><RootNamespace>MnahelsCafe.Desktop</RootNamespace><Version>0.15.57</Version><ApplicationIcon>Assets\MnahelsCafe.ico</ApplicationIcon><Company>Eastern Cross Technology</Company><Authors>Eastern Cross Technology (techmint.org)</Authors><Product>Mnahel's Cafe POS · a product by Eastern Cross Technology</Product><Copyright>Copyright © 2026 Eastern Cross Technology · techmint.org · All rights reserved.</Copyright><Trademark>Eastern Cross Technology</Trademark><Description>Proprietary desktop shell for Mnahel's Cafe POS, owned by Eastern Cross Technology.</Description></PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" /><None Include="Assets\MnahelsCafe.ico" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <Target Name="GenerateMnahelsDesktopIcon" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT' and Exists('$(MSBuildProjectDirectory)\..\MnahelsCafe.Pos\Assets\MnahelsCafe.ico.b64')"><MakeDir Directories="$(ProjectDir)Assets" /><Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;[IO.File]::WriteAllBytes('$(ProjectDir)Assets\MnahelsCafe.ico',[Convert]::FromBase64String([IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\MnahelsCafe.Pos\Assets\MnahelsCafe.ico.b64')))&quot;" /><Exec Command="node &quot;$(MSBuildProjectDirectory)\..\..\scripts\apply-desktop-performance.cjs&quot;" /><Exec Command="node &quot;$(MSBuildProjectDirectory)\..\..\scripts\apply-desktop-printing-v54.cjs&quot;" /><Exec Command="node &quot;$(MSBuildProjectDirectory)\..\..\scripts\apply-v57-receipt-consistency.cjs&quot; desktop" /></Target>
</Project>
